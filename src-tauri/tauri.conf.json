{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "PDF Editor",
  "version": "0.5.0",
  "identifier": "com.pdfeditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDF Editor",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#191b1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "resources": {
      "../bin/pdfium.dll": "bin/pdfium.dll",
      "../bin/pdfium-notices/": "bin/pdfium-notices/",
      "../node_modules/@fontsource-variable/manrope/LICENSE": "licenses/Manrope-OFL.txt",
      "../node_modules/@fontsource-variable/lora/LICENSE": "licenses/Lora-OFL.txt",
      "../node_modules/lucide/LICENSE": "licenses/Lucide.txt",
      "../node_modules/tailwindcss/LICENSE": "licenses/Tailwind-CSS.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
